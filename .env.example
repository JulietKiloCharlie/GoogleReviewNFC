# Public browser configuration. The anon key is designed to be public.
# Row-level security decides what it can read and write. Never put the
# service-role key, a Resend key, or any other secret in this file.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Optional. Leave unset during local development to use the current site origin.
# Set this in production so copied NFC links use the permanent public domain.
VITE_PUBLIC_SITE_URL=https://reviews.example.com
